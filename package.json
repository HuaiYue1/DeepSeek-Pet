{
  "name": "deepseek-pet",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek-Pet（大肥鱼）— a DeepSeek-inspired whale-girl desktop pet",
  "author": "HuaiYue",
  "license": "MIT",
  "type": "module",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "art": "node art/build.mjs",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright": "~1.56.1"
  },
  "build": {
    "appId": "io.github.huaiyue1.deepseek-pet",
    "productName": "DeepSeek-Pet",
    "files": [
      "app/**/*",
      "art/png/*.png",
      "art/states.mjs",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DeepSeek-Pet",
      "artifactName": "DeepSeek-Pet-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DeepSeek-Pet-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "app/icon.png",
      "category": "public.app-category.entertainment",
      "artifactName": "DeepSeek-Pet-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "app/icon.png",
      "category": "Game"
    }
  }
}
